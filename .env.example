# Copy to .env and fill in.
#
# docker compose reads this file for ${VAR} interpolation and passes the values
# into the container as environment variables. Those override the matching keys
# in config.yaml (SMTP_SWITCH_<SECTION>__<KEY>, double underscore = nesting).
#
# The application itself does NOT read .env when run outside Docker — use real
# environment variables or config.yaml for the from-source workflow.

# REQUIRED. Signs the dashboard session cookie. Generate a long random value:
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
SMTP_SWITCH_WEB__SESSION_SECRET=

# --- Optional overrides (see config.example.yaml for the full set) ------------

# Provider SMTP passwords, referenced as ${...} from config.yaml:
# SMTP2GO_USER=
# SMTP2GO_PASS=
# MAILGUN_PASS=

# SMTP_SWITCH_LOGGING__LEVEL=INFO
# SMTP_SWITCH_LOGGING__JSON=true
# SMTP_SWITCH_INGRESS__REQUIRE_AUTH=true
